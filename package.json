{
    "name": "estelarjs",
    "version": "0.0.1",
    "description": "Nodecaf is a light framework for developing RESTful Apps in a quick and convenient manner.",
    "main": "./lib/main.js",
    "types": "./lib/types.d.ts",
    "type": "module",
    "scripts": {
        "test": "npx dumbug mocha -b --no-diff test/*.js",
        "test-full": "node scripts/full.js",
        "test-docker": "node scripts/docker.js",
        "types": "npx tsc",
        "lint": "npx eslint lib",
        "cov": "npx c8 -r html -r text-summary mocha -b --no-diff --no-warnings test/*.js",
        "quality": "qlty init && (qlty smells -a --sarif) > ./.qlty/out/report.sarif && qlty metrics ./lib"
    },
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/GCSBOSS/nodecaf.git"
    },
    "keywords": [
        "http",
        "routing",
        "logging",
        "config",
        "promises",
        "async",
        "await",
        "error",
        "light",
        "framework",
        "api",
        "rest",
        "nodejs",
        "server"
    ],
    "author": "Guilherme C. Souza",
    "license": "MIT",
    "files": [
        "lib"
    ],
    "bugs": {
        "url": "https://gitlab.com/GCSBOSS/nodecaf/issues"
    },
    "homepage": "https://gitlab.com/GCSBOSS/nodecaf#README",
    "dependencies": {
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.7.1",
        "@types/node": "^25.2.2",
        "blessed": "^0.1.81",
        "eslint": "^10.0.0",
        "eslint-formatter-gitlab": "^7.0.1",
        "eslint-plugin-mocha": "^11.2.0",
        "globals": "^17.3.0",
        "mocha": "^11.7.5",
        "split-exec": "^0.0.2",
        "toml": "^3.0.0",
        "typescript": "^5.9.3"
    }
}
